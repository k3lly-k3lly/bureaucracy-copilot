# Copy this file to .env for running the API outside Docker.
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# Free key from https://console.groq.com/keys (no credit card). Keep it secret: .env is git-ignored.
GROQ_API_KEY=
