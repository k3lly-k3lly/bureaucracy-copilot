# Copy this file to .env for running the API outside Docker.
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# Free key from https://console.groq.com/keys (no credit card). Keep it secret: .env is git-ignored.
GROQ_API_KEY=
# Optional: switch model if Groq changes its lineup
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: questions allowed per visitor (IP address). Defaults: 5 a minute, 30 a day.
# ASK_PER_MINUTE=5
# ASK_PER_DAY=30
# FEEDBACK_PER_MINUTE=10
